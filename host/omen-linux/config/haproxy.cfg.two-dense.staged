global
    log stdout format raw local0
    maxconn 512
    stats socket /home/derek/.local/share/omen-vllm/haproxy.sock mode 600 level admin

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    # 2026-09-27 sizing-map: cover HEARTH's deadline ceiling (2400 s) and queue overflow at the
    # router instead of inside vLLM (per-server maxconn = the seat's max_num_seqs).
    timeout client 2400s
    timeout server 2400s
    timeout queue 60s

# Lane 1: MoE throughput seat(s) — same port and alias HEARTH already uses.
frontend omen_vllm
    bind 127.0.0.1:18090
    default_backend moe_seats

backend moe_seats
    # two-dense window: no 30B seat exists; :18090 answers 503 instead of sending the 30B's model name to the 27B.
    balance leastconn

# Lane 2: dense quality seat (Qwen3.8-27B + MTP) — own port so HEARTH can route by tag.
frontend omen_dense
    bind 127.0.0.1:18095
    default_backend dense_seats

backend dense_seats
    balance leastconn
    option httpchk GET /health
    http-check expect status 200
    server b70_0 127.0.0.1:18091 maxconn 4 check inter 2s fall 2 rise 2

# Lane 3 (two-dense window): second dense seat on card 1, own port so HEARTH routes it as omen-dense-27b-b.
frontend omen_dense_b
    bind 127.0.0.1:18096
    default_backend dense_seats_b

backend dense_seats_b
    balance leastconn
    option httpchk GET /health
    http-check expect status 200
    server b70_1 127.0.0.1:18092 maxconn 4 check inter 2s fall 2 rise 2
