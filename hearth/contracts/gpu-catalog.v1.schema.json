{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandcenter.local/hearth/contracts/gpu-catalog.v1.schema.json",
  "title": "Physical GPU inference catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "gathered_at", "host", "hardware_profile_id", "gates", "cards", "models"],
  "properties": {
    "contract_version": {"const": "gpu-catalog.v1"},
    "gathered_at": {"type": "string", "format": "date-time"},
    "host": {"type": "string", "minLength": 1},
    "hardware_profile_id": {"type": "string", "minLength": 1},
    "resident_models": {"type": "array", "items": {"type": "string"}},
    "staging_slots": {"type": "integer", "minimum": 1},
    "gates": {"type": "object", "required": ["vram_headroom_gb"],
      "properties": {"vram_headroom_gb": {"type": "number", "minimum": 0}}},
    "cards": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["index", "uuid", "bdf", "vram_gb", "label"],
      "properties": {"index": {"type": "integer", "minimum": 0}, "uuid": {"type": "string"},
        "bdf": {"type": "string"}, "vram_gb": {"type": "number", "exclusiveMinimum": 0},
        "label": {"type": "string"}}}},
    "models": {"type": "array", "items": {"type": "object",
      "required": ["model_id", "placement", "vram_gb", "per_card_gb", "expected_gen_tps", "sample_count"],
      "properties": {"model_id": {"type": "string"}, "alias": {"type": ["string", "null"]},
        "placement": {"enum": ["single", "dual"]}, "visible_devices": {"type": "null"},
        "vram_gb": {"type": ["number", "null"]}, "per_card_gb": {"type": ["number", "null"]},
        "expected_gen_tps": {"type": ["number", "null"]},
        "warmup_ms_p50": {"type": ["number", "null"]},
        "warmup_ms_max": {"type": ["number", "null"]},
        "sample_count": {"type": "integer", "minimum": 0}, "notes": {"type": ["string", "null"]},
        "qualified_task_classes": {"type": "array", "items": {"type": "string"}},
        "quality_evidence": {"type": "string"}}}}
  }
}
