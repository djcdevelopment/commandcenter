  "cards": [
    {
      "dot": "cyan",
      "title": "Authorization mirrors discovery",
      "items": [
        "An unprofiled caller is denied every tool, not granted every tool",
        "list_tools is filtered by the same profile that authorizes the call, so a caller cannot even see what it may not run"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fail closed",
      "items": [
        "Every registered tool must be classified in TOOL_CAPABILITY, checked against what actually registered",
        "An unclassified tool raises at startup: a door that half-knows its own policy stays shut"
      ]
    },
    {
      "dot": "amber",
      "title": "The door routes itself",
      "items": [
        "Just call local_generate and pin only with cause; trust routed_by on the result",
        "A pin picks the rung, not the physics: an over-budget payload is refused at the door, never dispatched to die at the server"
      ]
    }
  ]
