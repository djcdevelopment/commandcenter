# Next lap (staged): Devstral Small 2 24B AWQ - current-generation, agent-tuned, attention-only (Mistral arch). Apply = rename, restart seat 0.
[Service]
Environment=OMEN_MODEL=/home/derek/models/devstral-small-2-24b-awq-int4
Environment=OMEN_SERVED_NAME=devstral-small-2
Environment=OMEN_QUANTIZATION=compressed-tensors
Environment=OMEN_TOOL_PARSER=mistral
Environment=OMEN_REASONING_PARSER=
Environment=OMEN_THINKING_DEFAULT_OFF=0
Environment=OMEN_MAX_MODEL_LEN=65536
Environment=OMEN_LANGUAGE_MODEL_ONLY=1
Environment=OMEN_MTP_K=
Environment=OMEN_MTP_NO_BLOCK_DROP=0
Environment=OMEN_PREFIX_MATCH_UNIT=
Environment=OMEN_KV_CACHE_BYTES=
Environment=OMEN_GPU_MEM_UTIL=0.90
