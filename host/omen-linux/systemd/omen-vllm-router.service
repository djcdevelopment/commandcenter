[Unit]
Description=OMEN vLLM two-B70 router
After=omen-vllm@0.service omen-vllm@1.service omen-nemotron-74b.service

[Service]
Type=simple
ExecStart=/home/derek/opt/haproxy/usr/sbin/haproxy -db -f /home/derek/.config/omen-vllm/haproxy.cfg
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
