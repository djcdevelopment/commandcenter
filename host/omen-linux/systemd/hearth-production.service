[Unit]
Description=HEARTH Linux production controller on OMEN
After=omen-vllm-router.service
Wants=omen-vllm-router.service

[Service]
Type=simple
WorkingDirectory=/home/derek/work/commandcenter-linux-flash
Environment=PYTHONPATH=/home/derek/work/commandcenter-linux-flash
Environment=PATH=/home/derek/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HEARTH_ROOT=/home/derek/hearth-production
Environment=HEARTH_EXECUTION_DIR=/home/derek/hearth-production/var/execution
Environment=HEARTH_ARTIFACT_DIR=/home/derek/hearth-production/var/execution/artifacts
Environment=HEARTH_COORDINATION_DB=/home/derek/hearth-production/var/execution/coordination.sqlite
Environment=HEARTH_BACKENDS=/home/derek/hearth-production/backends-linux.toml
Environment=HEARTH_SCOPE=/home/derek/work/commandcenter-linux-flash:/home/derek/work
Environment=HEARTH_DISPATCH_PAUSE_FILE=/home/derek/hearth-production/pause.dispatch
Environment=HEARTH_RECOVERY_SKIP_OPERATIONS=bf6.process_segment
Environment=HEARTH_SKIP_OPTIONAL_SUBSYSTEMS=1
EnvironmentFile=/home/derek/.config/omen-vllm/hearth-backends.env
ExecStart=/home/derek/.venvs/hearth-private/bin/python -m hearth.kernel.gateway --providers hearth.toolsurface.fs,hearth.toolsurface.git,hearth.toolsurface.testing,hearth.toolsurface.knowledge,hearth.toolsurface.summon,hearth.toolsurface.inference,hearth.toolsurface.execution_control,hearth.toolsurface.local_work,hearth.toolsurface.task_lane,hearth.toolsurface.fleet_harvest,hearth.toolsurface.patrol,hearth.toolsurface.masters_pet,hearth.toolsurface.dream,hearth.toolsurface.scheduler,hearth.toolsurface.am4,hearth.toolsurface.commander,hearth.toolsurface.build_requests,hearth.toolsurface.media_render,hearth.toolsurface.image_generate,hearth.toolsurface.media_generate,hearth.toolsurface.rotation,hearth.toolsurface.rungstate,hearth.toolsurface.operator --callers /home/derek/hearth-production/var/callers.json --host 127.0.0.1 --port 8710 --no-timers --threaded-tools
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
