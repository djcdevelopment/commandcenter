# HEARTH environment: dev. R&D laps in the daytime with the operator at the machine.
# Relaxes schedule/presence policy only; safety gates are never knobs (ADR-0053). Every receipt
# written under dev carries environment=dev and lab-rnd's night audit excludes it.
# Rendered into ~/.config/hearth/environment by `hearth-env set dev --reason ... [--until ...]`.

# lab-rnd night_work: `night window open` works at any hour
NIGHT_WINDOW_ENFORCE=0
# lab-rnd night_work: an approved brief may be re-queued after it ran (iterate after a fix)
NIGHT_ALLOW_RERUN=1
# fleet presence: ignore idle time and RDP; pause.dispatch and ai-mode still hold dispatch
PRESENCE_GATE=off
# fleet presence: unused while PRESENCE_GATE=off; kept so switching the gate back needs no edit
PRESENCE_IDLE_MIN=20
# Banked Fire lane caps, lane=slots (c=8 on omen-nemotron-74b + 1 on am4-vllm)
BANKEDFIRE_SLOTS=fast=8,deep=8,experiment=1,deepagents=2,tool=2
# Frontier autonomy in dev mode: frontier agents (claude-frontier, codex-cli, helm-gemini) can vet, approve, and apply
APPROVAL_AUTHORITY=frontier
# Streamlined verdict paperwork: auto-populate criteria rows from summary when omitted
VERDICT_STRICT_PAPERWORK=0
# Allow record_local_work_verdict(..., apply=True) / apply_local_work to write accepted candidates to disk
LOCAL_WORK_AUTO_APPLY=1
# Do not refuse new serving profiles lacking historical delivery-procedures-linux.json acceptance counts
PROCEDURE_QUALIFICATION_ENFORCE=0
# Interactive reserve slots left free when bankedfire-drain shares a multi-slot backend
DRAIN_RESERVE_SLOTS=1
# Enable Tier-0 NPU + /dev/shm AST context slicing by default for high-parameter delivery seats
HEARTH_JEPA_PACK=auto
