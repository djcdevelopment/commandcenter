# HEARTH environment: prod. The behaviour the lab had before environments existed (2026-10-02).
# Policy knobs only; safety gates are never knobs (ADR-0053). Rendered into
# ~/.config/hearth/environment by `hearth-env set prod --reason ...`. Code defaults equal these values.

# lab-rnd night_work: refuse `night window open` outside 22:00-23:30 America/Los_Angeles (1) or not (0)
NIGHT_WINDOW_ENFORCE=1
# lab-rnd night_work: allow re-queueing an approved brief whose hash is already dispatched/done (1) or not (0)
NIGHT_ALLOW_RERUN=0
# fleet presence: "idle" = operator away only after PRESENCE_IDLE_MIN idle minutes and no RDP;
# "off" = skip those two signals. pause.dispatch and ai-mode apply in every environment.
PRESENCE_GATE=idle
# fleet presence: idle minutes before the operator counts as away
PRESENCE_IDLE_MIN=20
# Banked Fire lane caps, lane=slots
BANKEDFIRE_SLOTS=fast=3,deep=1,experiment=1,deepagents=1,tool=2
