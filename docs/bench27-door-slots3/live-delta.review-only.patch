 # Qwen3.8-27B GPTQ-Int4 + MTP k=2, native XPU Flash Attention (ADR-0060, 2026-10-03) on one B70; 65,536 configured (KV pool 76,706-99,048 tokens depending on the start (vLLM profiles free memory) -> ~1.2-1.5 full-length requests, so slots stay small).
 context_tokens = 65536
 context_bytes = 229376
 max_tokens = 16384   # the output reserve; == work.produce ceiling (sizing-map 2026-09-27)
 deliberate_max_tokens = 24576   # inference.deliberate only: a streamed thinking turn may ask up to this (65,536 window)
 timeout_s = 1000
-parallel_slots = 2       # KV pool 99,048 tokens holds ~1.5 full requests; 2 x (19.5K in + 16K out) = 71K fits, 3 preempted (9.3 s wait 2026-09-27)
+parallel_slots = 3       # Temporary Bench27 door-slots3 arm; restore 2 after owned jobs drain.
 structured_outputs = true   # response_format json_schema, probed 2026-10-02 (docs/structured-outputs.md)
 flash_attention = true   # the seat's --attention-backend FLASH_ATTN; part of the serving profile a capability record carries
 speculative = "mtp-k2"    # the seat's MTP draft depth; sizing_map checks both against the seat's drop-ins
 
 [backend.settings.chat_template_kwargs]
 enable_thinking = false
 
 # --- AM4 profile tool-pair (2026-09-28) --------------------------------------------------------
 # One Qwen3-8B-AWQ seat per card behind the oxen facade, tag `tool-use` for OS-local chores
 # (read / grep / summarize through the DeepAgents runner). Live only while `am4-profile tool-pair`
 # is active on AM4; the occupancy probe asks the facade for the alias, so a dead alias reads
 # "unknown" and tag routes skip it. The 4070 Ti is declared first: it is the prefill seat
 # (2,920 vs 2,493 tok/s on the 14B reader, docs/rnd-log.md 2026-09-18). The family that routes
 # here (`tool_execution` -> tags ["tool-use"]) is retargeted only after the chore lap passes.
 [[backend]]
 name = "am4-tool-4070ti"
 endpoint = "http://10.44.0.2:8090"
 api = "openai"
 models = ["am4-tool-4070ti"]
 tags = ["tool-use"]
 auth_env = "AM4_VLLM_TOKEN"
 [backend.settings]
 node = "am4"
 engine = "vllm"
