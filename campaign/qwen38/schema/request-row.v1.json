{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen38-request.v1",
  "title": "Qwen 3.8 campaign request row",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "run_id",
    "candidate",
    "topology",
    "endpoint",
    "model",
    "test_kind",
    "mtp_enabled",
    "concurrency",
    "started_at",
    "completed_at",
    "success",
    "valid",
    "latency_s"
  ],
  "additionalProperties": true,
  "properties": {
    "contract_version": {"const": "qwen38-request.v1"},
    "request_id": {"type": "string", "pattern": "^q38-[0-9a-f]{20}$"},
    "run_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "string", "minLength": 1},
    "topology": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": ["string", "null"]},
    "artifact_revision": {"type": ["string", "null"]},
    "model_quant": {"type": ["string", "null"]},
    "placement": {"type": ["string", "null"]},
    "test_kind": {"enum": ["performance", "assay", "soak"]},
    "task_id": {"type": ["string", "null"]},
    "task_family": {"type": ["string", "null"]},
    "mtp_enabled": {"type": "boolean"},
    "seed": {"type": ["integer", "null"]},
    "concurrency": {"type": "integer", "minimum": 1},
    "slot_depth": {"type": "integer", "minimum": 0},
    "parallel_slots": {"type": "integer", "minimum": 0},
    "client_id": {"type": ["integer", "null"], "minimum": 0},
    "image_asset": {"type": ["string", "null"]},
    "image_bytes": {"type": ["integer", "null"], "minimum": 0},
    "image_width": {"type": ["integer", "null"], "minimum": 1},
    "image_height": {"type": ["integer", "null"], "minimum": 1},
    "shared_postload_gb": {"type": ["number", "null"], "minimum": 0},
    "commit_preload_gb": {"type": ["number", "null"], "minimum": 0},
    "commit_postload_gb": {"type": ["number", "null"], "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "http_status": {"type": ["integer", "null"]},
    "success": {"type": "boolean"},
    "valid": {"type": "boolean"},
    "failure_class": {"type": ["string", "null"]},
    "latency_s": {"type": "number", "minimum": 0},
    "ttft_s": {"type": ["number", "null"], "minimum": 0},
    "ttft_source": {"type": ["string", "null"]},
    "prompt_ms": {"type": ["number", "null"], "minimum": 0},
    "predicted_ms": {"type": ["number", "null"], "minimum": 0},
    "prompt_tokens_per_s": {"type": ["number", "null"], "minimum": 0},
    "decode_tokens_per_s": {"type": ["number", "null"], "minimum": 0},
    "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
    "generated_tokens": {"type": ["integer", "null"], "minimum": 0},
    "drafted_tokens": {"type": ["integer", "null"], "minimum": 0},
    "accepted_tokens": {"type": ["integer", "null"], "minimum": 0},
    "retrieval_expected": {"type": ["string", "null"]},
    "retrieval_position_fraction": {"type": ["number", "null"], "enum": [0.1, 0.5, 0.9, null]},
    "requested_max_tokens": {"type": ["integer", "null"], "minimum": 1},
    "request_payload_bytes": {"type": ["integer", "null"], "minimum": 1},
    "response_text": {"type": "string"},
    "tool_calls": {"type": "array"}
  }
}
