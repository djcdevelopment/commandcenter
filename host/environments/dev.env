# HEARTH environment: dev. R&D laps in the daytime with the operator at the machine.
# Relaxes schedule/presence policy only; safety gates are never knobs (ADR-0053). Every receipt
# written under dev carries environment=dev and lab-rnd's night audit excludes it.
# Rendered into ~/.config/hearth/environment by `hearth-env set dev --reason ... [--until ...]`.

# lab-rnd night_work: `night window open` works at any hour
NIGHT_WINDOW_ENFORCE=0
# lab-rnd night_work: an approved brief may be re-queued after it ran (iterate after a fix)
NIGHT_ALLOW_RERUN=1
# fleet presence: ignore idle time and RDP; pause.dispatch and ai-mode still hold dispatch
PRESENCE_GATE=off
# fleet presence: unused while PRESENCE_GATE=off; kept so switching the gate back needs no edit
PRESENCE_IDLE_MIN=20
# Banked Fire lane caps, lane=slots
BANKEDFIRE_SLOTS=fast=3,deep=1,experiment=1,deepagents=1,tool=2
