## HEARTH reverse proxies -- two sites in one Caddy process.
#
#   :8711  Funnel-facing hop in front of the HEARTH gateway (/mcp -> :8710).
#   :8083  VM inference proxy in front of llama-swap (/v1 -> :8081). See
#          hearth/etc/caddy/README.md; added 2026-09-06 (B-06).
#
# ONE PROCESS, TWO BLAST RADII: a syntax error, a bind failure or a crash here
# takes the PUBLIC Funnel door down with it. Run `caddy validate` before every
# commit, and do not introduce a listener whose address might not exist at boot
# (see the bind note on :8083 below).
#
# HEARTH's gateway serves exactly one HTTP path (/mcp, streamable-http; see
# hearth/kernel/gateway.py's module docstring) and binds 127.0.0.1:8710 only.
# This proxy sits between Tailscale Funnel and the gateway so Funnel never
# exposes the bare gateway port directly to the internet: `tailscale funnel`
# targets THIS port, not 8710.
#
# ── REBUILT 2026-08-24 (amends ADR-0025) ─────────────────────────────────────
# The original version STAMPED a fixed X-Hearth-Key onto every request, because
# the only external caller then (Google Agent Platform Studio's MCP tool) had
# `Authentication: None` and could not send a header at all. That made the
# Funnel URL itself the de facto shared secret. ADR-0025 accepted it explicitly
# as a bounded, temporary trade and said to drop the stamp once a real caller
# could send its own header.
#
# Two things forced the revisit:
#   1. The stamped key LEAKED. Caddy's reverse_proxy error logging serialises
#      the whole request object, headers included, so the live key sat in
#      plaintext in hearth/var/caddy-funnel-proxy.log (5 occurrences). Rotated
#      2026-08-24; the log with the old value has been destroyed.
#   2. The next external caller (a peer's Hermes router) CAN send headers, so
#      the reason for the stamp no longer applies to it.
#
# So: NO stamped secret. Callers present their own X-Hearth-Key and are
# identified per-request by the gateway's normal ADR-0019 path. The URL is no
# longer a credential -- knowing it gets you a 401, not read access.
#
# CONSEQUENCE, stated plainly: the GCP Studio lane goes dark until Studio ships
# API-key auth for its MCP tool. That is the trade ADR-0025 pre-authorised.
# ─────────────────────────────────────────────────────────────────────────────
#
# Run:  caddy run --config hearth/etc/caddy/Caddyfile --adapter caddyfile
# Boot: the HearthFunnelProxyBoot scheduled task (see fleet/funnelproxy/).
{
	# The leak was NOT the access log -- it was the DEFAULT logger, which
	# reverse_proxy uses for warnings like "aborting with incomplete response"
	# and which serialises request>headers verbatim. Filter it at the source so
	# no future handler can reintroduce the same leak.
	log default {
		output file C:\work\commandcenter\hearth\var\caddy-funnel-proxy.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap console
			fields {
				request>headers>X-Hearth-Key delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

:8711 {
	# Same redaction on the access log. Both loggers, or neither is safe.
	log {
		output file C:\work\commandcenter\hearth\var\caddy-funnel-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap console
			fields {
				request>headers>X-Hearth-Key delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# Friend gate (ADR-0046): an invited friend's OWN agent (OpenHands, aider, Cline ...) speaks
	# OpenAI chat-completions here with a per-friend key. The GATE authenticates, budgets, limits
	# and ledgers; this block only narrows and forwards. Its upstream is the gate on loopback
	# (:8791), NEVER llama-swap: the Funnel must not become an anonymous mouth for the rung
	# (hearth/tests/proxy/test_vm_proxy_caddyfile.py proves /v1 here dials the gate's port only).
	# No bearer is stamped on this hop either -- the friend presents their own key, the gate
	# injects the rung's on the far side.
	handle /v1/* {
		request_body {
			max_size 32MiB
		}
		reverse_proxy 127.0.0.1:8791 {
			header_up Host 127.0.0.1:8791
			flush_interval -1
		}
	}

	handle /mcp* {
		reverse_proxy 127.0.0.1:8710 {
			# HEARTH's gateway allowlists Host by value (loopback only,
			# ADR-0022's DNS-rebinding guard in gateway.py's
			# _transport_security) -- rewrite so the public Funnel hostname
			# the client actually sent doesn't get rejected as untrusted.
			header_up Host 127.0.0.1:8710

			# NOTE: no header_up for X-Hearth-Key. Client-supplied headers pass
			# through by default, which is exactly what we want now -- each
			# caller authenticates as itself. Re-adding a stamp here would
			# re-create the URL-as-secret hole; don't.
		}
	}

	# Defense in depth: /mcp is the gateway's only real path. Everything else
	# 404s rather than reaching the gateway process at all.
	handle {
		respond 404
	}
}

## ── VM inference proxy (added 2026-09-06, B-06) ──────────────────────────────
#
# Builder VMs decode on an 8 GB fx99 sidecar because llama-swap on 127.0.0.1:8081
# mixes an OpenAI-compatible /v1 surface with UNAUTHENTICATED admin endpoints
# (/api/models/unload*, /upstream/*, /running, /unload, /ui, /logs, /metrics).
# Binding :8081 beyond loopback would let any VM unload production. This block
# narrows the surface to inference only and injects the upstream bearer, so the
# VMs can reach the B70 rung without ever seeing an admin path or a token.
#
#   VM -> omen.mshome.net:8083 (here) -> 127.0.0.1:8081 (llama-swap) -> :8082
#
# LISTENER BOUNDARY -- `:8083` binds every interface, same as :8711 above, and
# the boundary is ONE inbound firewall rule scoped to the Default Switch
# interface (README.md has the exact command; Derek runs it). The tempting
# alternative -- `bind omen.mshome.net`, so the listener follows the Default
# Switch prefix across its reboot drift -- was MEASURED and REJECTED on
# 2026-09-06: that name resolves to TWO addresses here, 172.31.96.1 (the live
# switch) and 172.25.96.1 (a stale registration bound to no interface). A bind
# of the stale one fails with WSAEADDRNOTAVAIL, and Caddy exits rather than
# starting partially -- which would take the PUBLIC :8711 door down at every
# boot. Never make this process's startup depend on an address that may not
# exist yet.
:8083 {
	# Same redaction as the Funnel block. The global `log default` above already
	# covers reverse_proxy's own warnings for BOTH sites.
	log {
		output file C:\work\commandcenter\hearth\var\caddy-vm-proxy-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap console
			fields {
				request>headers>X-Hearth-Key delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# 32 MiB. The rung serves 2 slots x 64k tokens; the door's own files= pack
	# cap is 1 MiB, and a 64k-token prompt is well under 1 MiB of JSON. This is
	# ~30x the largest legitimate request -- it can never truncate real work,
	# and it bounds a hostile body far below anything that pressures the host.
	request_body {
		max_size 32MiB
	}

	# FAIL CLOSED. With the launcher started without the token, `{env....}`
	# expands to empty and we would forward `Bearer ` upstream. llama-server on
	# :8082 does enforce LLAMA_API_KEY (fleet/arcserve/serve-arc-swap.cmd sets it
	# from OMEN_ARC_TOKEN; fleet/arcserve/cutover.ps1 step D asserts a bare
	# request gets 401), so a decode would still be refused -- but llama-swap
	# answers parts of /v1 (e.g. the model list) from its OWN config without
	# touching the upstream, and whether v251 gates those on a bearer is not
	# knowable from anything tracked in this repo. So the refusal is made HERE,
	# where it is ours to guarantee: no token, no proxy, for any path.
	@noauth expression {env.OMEN_ARC_TOKEN} == ""

	route {
		respond @noauth "vm inference proxy: upstream credential unavailable" 503

		handle /v1/* {
			reverse_proxy 127.0.0.1:8081 {
				# `header_up <name> <value>` is a SET: it replaces whatever the
				# client sent, so a VM cannot substitute its own bearer. Do NOT
				# "harden" this by adding `header_up -Authorization` first --
				# Caddy's header handler applies deletes AFTER sets, so the pair
				# would strip the credential we just injected and every request
				# would 401. The proof
				# (hearth/tests/proxy/test_vm_proxy_caddyfile.py) sends
				# `Authorization: Bearer evil` and asserts the upstream sees the
				# injected value instead.
				header_up Authorization "Bearer {env.OMEN_ARC_TOKEN}"

				# llama-swap routes on its own config, but keep the Host honest
				# and loopback-shaped for the same reason as the :8711 block.
				header_up Host 127.0.0.1:8081
			}
		}

		# Everything that is not /v1 -- the whole admin surface included -- 404s
		# without a dial. Deliberately ONE catch-all rather than an enumerated
		# `handle /api/*`: an explicit admin list would be redundant here and
		# would invite the reading that only the listed paths are blocked. The
		# rule is an allow-list of exactly /v1/*; the proof asserts 404 for
		# /api/models, /upstream/x, /running, /unload, /ui, /metrics, /logs and
		# /, and asserts the upstream saw none of them.
		handle {
			respond 404
		}
	}
}
