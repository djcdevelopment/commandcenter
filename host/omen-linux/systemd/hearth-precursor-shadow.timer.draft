# Installed 2026-10-16 as ~/.config/systemd/user/hearth-precursor-shadow.timer (ADR-0070 proposed): the 30-minute
# catch-all sweep; hearth-precursor-shadow.path fires the same service on work-dir creation. See the .service.draft header.
[Unit]
Description=HEARTH precursor shadow sweep every 30 minutes (stage 1: unexposed)

[Timer]
OnBootSec=10min
# 2026-10-16: ran at 2min as a stopgap while the path unit could not start (inotify watch limit 65,536 held by one
# dotnet process); Derek raised fs.inotify.max_user_watches to 524,288 and the path unit started, so 30min is restored.
OnUnitActiveSec=30min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
