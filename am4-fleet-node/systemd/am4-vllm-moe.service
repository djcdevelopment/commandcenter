[Unit]
Description=AM4 local-work fast lane (Qwen3-30B-A3B GPTQ on vLLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=derek
Group=derek
EnvironmentFile=/home/derek/.config/am4-fleet/vllm-moe.env
ExecStart=/home/derek/.venvs/vllm/bin/vllm serve Qwen/Qwen3-30B-A3B-GPTQ-Int4 --host 127.0.0.1 --port 8001 --served-model-name qwen3-30b-a3b-gptq-int4 --tensor-parallel-size 2 --max-model-len 16384 --max-num-seqs 4 --gpu-memory-utilization 0.90 --max-num-batched-tokens 16384 --trust-remote-code
Restart=on-failure
RestartSec=5
TimeoutStartSec=1200
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
