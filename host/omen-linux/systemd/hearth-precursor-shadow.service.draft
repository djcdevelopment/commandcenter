# Installed 2026-10-16 as ~/.config/systemd/user/hearth-precursor-shadow.service (ADR-0070 still Proposed; Gate 1
# read "proceed" for bm25 and the stage-1 shadow went live at the 2026-10-16 cutover). Triggered by
# hearth-precursor-shadow.timer (30-minute catch-all) and hearth-precursor-shadow.path (work-dir creation, added
# 2026-10-16 by cc-20b3ab45). The README's `cp host/omen-linux/systemd/*.{service,timer}` step skips the .draft files.
#
# Off the door's request path: a user oneshot that rebuilds knowledge/precursor_index.json, writes
# precursor/advice.json for runs without one, and joins advice to verdicts. HEARTH_PRECURSOR defaults
# to off; the unit sets shadow explicitly so the env file cannot silently turn it on elsewhere.
[Unit]
Description=HEARTH precursor shadow materializer (index, advice, accuracy join; nothing displayed)
After=hearth-production.service
# Owner's correction (cc-c657d41c): no Conflicts= on the drain. systemd's Conflicts= STOPS the other unit
# when this one starts, which would kill a drain tick. The sweep costs ~1 s of CPU at nice 10 and reads only
# metadata, so no scheduling guard is needed; it may run beside the drain.

[Service]
Type=oneshot
WorkingDirectory=/home/derek/work/commandcenter-linux-flash
EnvironmentFile=-/home/derek/.config/hearth/hearth-ops.env
Environment=HEARTH_PRECURSOR=shadow
Environment=HEARTH_PRECURSOR_CORPUS=/home/derek/work/lab-rnd/research/precursor/corpus/v1/runs.jsonl
Environment=PYTHONPATH=/home/derek/work/commandcenter-linux-flash
Nice=10
MemoryMax=2G
ExecStart=/home/derek/.venvs/hearth-private/bin/python tools/workflow/project_precursor.py --build-index --advise --join
TimeoutStartSec=300
