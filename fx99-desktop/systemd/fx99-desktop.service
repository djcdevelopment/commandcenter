[Unit]
Description=FX99 lightweight virtual desktop
Requires=fx99-xorg.service
After=fx99-xorg.service

[Service]
Type=simple
User=derek
Group=derek
SupplementaryGroups=video render input
WorkingDirectory=/home/derek
RuntimeDirectory=fx99-desktop
RuntimeDirectoryMode=0700
Environment=HOME=/home/derek
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/fx99-desktop
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do DISPLAY=:0 /usr/bin/xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/local/lib/fx99-desktop/desktop-session.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
