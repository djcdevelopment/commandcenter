{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandcenter.local/hearth/contracts/inspection-bundle.v1.schema.json",
  "title": "Inspection bundle (what `operator inspect --json` returns)",
  "description": "Catalog reference, the immutable capacity snapshot inline, and this caller's authority. Only `authority` and `presentation` may differ between two callers reading the same CURRENT.json; the catalog and the snapshot document are byte-identical for everyone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "catalog", "capacity_snapshot", "authority", "presentation"],
  "properties": {
    "contract_version": {"const": "inspection-bundle.v1"},
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_version", "path"],
      "properties": {
        "catalog_version": {"$ref": "#/$defs/identity"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "capacity_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "kind", "path", "observed_at", "planning_valid_until", "document"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["planning", "validation"]},
        "path": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "planning_valid_until": {"$ref": "#/$defs/timestamp"},
        "document": {"type": "object",
                     "description": "The snapshot file's own bytes, parsed. Never edited by a reader."}
      }
    },
    "authority": {"type": "object", "description": "This caller's authority.v1 document."},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "planning_window_remaining_s", "freshness_now"],
      "description": "Reader-side rendering, excluded from every identity. Freshness is computed against the reader's own clock; the snapshot file is never modified.",
      "properties": {
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "planning_window_remaining_s": {"type": "integer"},
        "freshness_now": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["fresh", "age_s", "fresh_until"],
            "properties": {
              "fresh": {"type": "boolean"},
              "age_s": {"type": "integer"},
              "fresh_until": {"$ref": "#/$defs/timestamp"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
